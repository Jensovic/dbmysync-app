{
    "name": "jensovic/dbmysync-addin",
    "description": "Tiny read-only HTTP endpoint that exposes a MySQL/MariaDB schema (tables, columns, keys, indexes) behind a secret - so DbMySync can diff local and production databases on shared hosting without SSH or remote MySQL access.",
    "keywords": [
        "mysql",
        "mariadb",
        "schema",
        "schema-diff",
        "schema-comparison",
        "database-diff",
        "database-migration",
        "migration",
        "sync",
        "database-sync",
        "information-schema",
        "shared-hosting",
        "deployment",
        "devops",
        "endpoint",
        "rest-api"
    ],
    "homepage": "https://github.com/Jensovic/dbmysync-addin",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jensovic",
            "email": "jensovic@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Jensovic/dbmysync-addin/issues",
        "source": "https://github.com/Jensovic/dbmysync-addin",
        "docs": "https://github.com/Jensovic/dbmysync-app/tree/main/docs"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Jensovic\\DbMySyncAddin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jensovic\\DbMySyncAddin\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
