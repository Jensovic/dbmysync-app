{
    "name": "jensovic/dbmysync",
    "description": "Compare MySQL/MariaDB schemas between local and production over HTTP and get ready-to-run ALTER/CREATE TABLE statements - built for shared hosting without SSH or remote database access.",
    "keywords": [
        "mysql",
        "mariadb",
        "schema",
        "schema-diff",
        "schema-comparison",
        "database-diff",
        "database-migration",
        "migration",
        "sync",
        "database-sync",
        "alter-table",
        "sql-generator",
        "shared-hosting",
        "deployment",
        "devops",
        "dashboard"
    ],
    "homepage": "https://github.com/Jensovic/dbmysync-app",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Jensovic",
            "email": "jensovic@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Jensovic/dbmysync-app/issues",
        "source": "https://github.com/Jensovic/dbmysync-app",
        "docs": "https://github.com/Jensovic/dbmysync-app/tree/main/docs"
    },
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "guzzlehttp/guzzle": "^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Jensovic\\DbMySync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jensovic\\DbMySync\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
